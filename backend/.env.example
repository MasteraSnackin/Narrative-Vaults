# ===========================================
# Narrative Vaults Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://username:password@localhost:5432/narrative_vaults

# ===========================================
# Redis Configuration (for caching and queues)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Blockchain Configuration
# ===========================================
# HyperEVM RPC URL
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Backend wallet private key (for signing transactions)
# WARNING: Never commit real private keys to version control
BACKEND_WALLET_PRIVATE_KEY=0x...your_private_key_here

# ===========================================
# Salt Protocol Configuration
# ===========================================
# Salt Policy Account Factory contract address
SALT_FACTORY_ADDRESS=0x...salt_factory_address

# Admin address for emergency controls
ADMIN_ADDRESS=0x...admin_wallet_address

# ===========================================
# Pear Protocol Configuration
# ===========================================
# Pear API base URL
PEAR_API_BASE_URL=https://api.pear.garden

# Pear client ID (HLHackathon1-10 for hackathon)
PEAR_CLIENT_ID=HLHackathon1

# Pear API key (if required)
PEAR_API_KEY=

# Pear execution contract address on HyperEVM
PEAR_EXECUTION_CONTRACT_ADDRESS=0x...pear_contract_address

# ===========================================
# Token Addresses
# ===========================================
# USDC contract address on HyperEVM
USDC_CONTRACT_ADDRESS=0x...usdc_address

# ===========================================
# Agent Configuration
# ===========================================
# Agent loop interval in milliseconds (default: 30000 = 30 seconds)
AGENT_LOOP_INTERVAL_MS=30000

# ===========================================
# Security
# ===========================================
# JWT secret for authentication (generate a random string)
JWT_SECRET=your_jwt_secret_here

# API rate limiting (requests per minute)
RATE_LIMIT_RPM=100

# ===========================================
# Logging
# ===========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
