# Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# Backend API Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# =============================================================================
# Blockchain Configuration
# =============================================================================
# RPC endpoints for supported chains
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Chain IDs
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# =============================================================================
# WalletConnect Configuration
# =============================================================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# =============================================================================
# Smart Contract Addresses
# =============================================================================
# Update these with actual deployed contract addresses
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NARRATIVE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Salt Protocol Contracts
NEXT_PUBLIC_SALT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Pear Protocol Contracts
NEXT_PUBLIC_PEAR_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# API Keys
# =============================================================================
# Alchemy API Key (for blockchain data)
NEXT_PUBLIC_ALCHEMY_KEY=your_alchemy_api_key_here

# Infura API Key (alternative RPC provider)
NEXT_PUBLIC_INFURA_KEY=your_infura_api_key_here

# Etherscan API Key (for contract verification)
NEXT_PUBLIC_ETHERSCAN_API_KEY=your_etherscan_api_key_here

# =============================================================================
# Analytics & Monitoring
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Tracking
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_TESTNET=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_MAINTENANCE_MODE=false

# =============================================================================
# UI Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME="Narrative Vaults"
NEXT_PUBLIC_APP_DESCRIPTION="Gamified Pair Trading Platform for Market Narratives"

# Theme
NEXT_PUBLIC_DEFAULT_THEME=dark

# =============================================================================
# External Services
# =============================================================================
# Hyperliquid API
NEXT_PUBLIC_HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# CoinGecko API (for price data)
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key_here

# =============================================================================
# Development/Debug Settings
# =============================================================================
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# =============================================================================
# Security
# =============================================================================
# CSRF Protection
NEXT_PUBLIC_CSRF_ENABLED=true

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_ENABLED=true

# =============================================================================
# Social/Community Links
# =============================================================================
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-server
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-handle
NEXT_PUBLIC_GITHUB_URL=https://github.com/MasteraSnackin/Narrative-Vaults

# =============================================================================
# Notes
# =============================================================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Variables without NEXT_PUBLIC_ are server-side only
# - Never commit .env.local or .env with real credentials
# - Use .env.local for local development
# - Use environment variables in production (Vercel, etc.)
